# FleetGuard 30 — Opelika, AL (4400 Northpark Dr, Opelika, AL 36801)
# Production Environment Variables for Vercel + Supabase

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_HQ_ADDRESS="4400 Northpark Dr, Opelika, AL 36801"
NEXT_PUBLIC_HQ_LAT=32.6912
NEXT_PUBLIC_HQ_LNG=-85.3298
NEXT_PUBLIC_GARAGE_GEOFENCE_M=150
NEXT_PUBLIC_KEYBOX_BLE_M=3

# Supabase Realtime & PostgreSQL Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Console security PIN (4 digits). Verified server-side only; never shipped to the browser.
FLEET_ADMIN_PIN=4400

# Public base URL encoded into vehicle key-tag QR codes (falls back to the current origin)
NEXT_PUBLIC_APP_URL=https://vehiclemonitor.vercel.app
